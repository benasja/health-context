# `id -u` and `id -g` of the user the Health Bridge receiver runs as.
HEALTH_UID=1000
HEALTH_GID=1000

# The receiver's data folder (holds health.sqlite). Use the full path: compose
# does not expand ~, and under sudo $HOME would be root's.
HEALTH_BRIDGE_DIR=/home/you/.local/share/health-bridge

# Where the context pack goes. Create it first, owned by the user above.
# Put a profile.md here to have it included in every rebuild.
HEALTH_OUTPUT_DIR=/home/you/health-context-data

# Seconds between checks for new data. A check that finds nothing new costs
# one stat() call, so this only bounds how stale the pack can get.
HEALTH_SYNC_INTERVAL=900
